# Configuration reCAPTCHA Enterprise
# Clé secrète reCAPTCHA
RECAPTCHA_SECRET_KEY=XXXXXXXXX

# ID de votre projet Google Cloud (à récupérer depuis Google Cloud Console)
RECAPTCHA_PROJECT_ID=your_project_id_here

# Configuration API Odoo (optionnel, valeurs par défaut dans server.ts)
ODOO_API_URL=XXXXXXXX
X_SIGNATURE=your_x_signature_here
X_CLIENT_ID=XXXXXXX

# Port du serveur (optionnel, défaut: 4000)
PORT=4000
