{
  "name": "msl-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ssr": "ng build --configuration production",
    "serve:ssr": "node dist/msl-website/server/server.mjs",
    "dev:ssr": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "optimize-images": "node scripts/optimize-images-alternative.js",
    "optimize-images-manual": "node scripts/optimize-images-alternative.js --manual",
    "clean-images": "node scripts/optimize-images.js --clean",
    "build:optimized": "npm run optimize-images && ng build",
    "serve:ssr:MSL-Website": "node dist/msl-website/server/server.mjs",
    "generate-sitemap": "node generate-sitemap.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/platform-server": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/ssr": "^17.3.10",
    "@fortawesome/angular-fontawesome": "^0.14.1",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.3",
    "canvas-confetti": "^1.9.4",
    "express": "^4.18.2",
    "iframe-resizer": "^4.3.6",
    "ngx-countup": "^13.2.0",
    "ngx-spinner": "^17.0.0",
    "ngx-toastr": "^19.0.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.34.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/aos": "^3.0.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.17",
    "@types/iframe-resizer": "^4.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@vercel/node": "^5.6.21",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sitemap-generator": "^8.5.1",
    "typescript": "~5.2.2"
  }
